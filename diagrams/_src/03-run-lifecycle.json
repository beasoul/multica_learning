  "cards": [
    { "dot": "emerald", "title": "三件事必须分清", "items": ["deferred 是已排期，queued 是已入队，两者都不是失败", "dispatched 停留超过 5 分钟会被判失败，running 没有固定上限", "completed 只代表 Run 结束，不代表工作被接受，评审仍然是人的事"] },
    { "dot": "amber", "title": "两个容易误判的等待", "items": ["waiting_local_directory 只在 in_place 模式出现，切 worktree 即无队列", "queued 要同时满足运行时心跳缺席超宽限期，且自己也排满这么久才判失败", "宽限期由 MULTICA_RUNTIME_RECONNECT_GRACE 控制，默认 3 小时"] },
    { "dot": "rose", "title": "重试与终态", "items": ["普通运行默认最多 2 次尝试，工具网络中断最多 3 次", "鉴权、额度、模型配置类错误不自动重试", "手动 rerun 交给当时负责的那个智能体，而不是重新选人"] }
